# HubCash: copie para .env em desenvolvimento ou configure na Railway.
# Nunca coloque valores reais neste arquivo.

# Chave que cifra os tokens do Mercado Pago no banco (32+ caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se perder essa chave, as contas do Mercado Pago precisam ser cadastradas de novo.
HUBCASH_MASTER_KEY=

# Endereço público do HubCash (usado nos webhooks), ex.: https://hubcash.up.railway.app
HUBCASH_PUBLIC_URL=

# Banco: Postgres (a Railway preenche DATABASE_URL ao ligar um banco). A tabela é criada sozinha.
DATABASE_URL=
# Alternativa: Supabase (rode supabase/migrations/001_hubcash_records.sql antes).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Entrar com LINKY. O HubCash é app da casa: não precisa cadastrar nada no LINKY à mão.
# No LINKY (Vercel) configure LINKY_HUBCASH_CLIENT_ID=uwy_hubcash_... e LINKY_HUBCASH_URL={HUBCASH_PUBLIC_URL}.
# Aqui use o MESMO client id. Não há segredo (cliente público com PKCE).
LINKY_ISSUER=https://linky-delta1s-projects.vercel.app/api/identity
LINKY_CLIENT_ID=

# Conta administradora: IDs LINKY do dono (os mesmos de LINKY_ADMIN_USER_IDS no LINKY), separados por vírgula.
HUBCASH_ADMIN_LINKY_IDS=

# Só para desenvolvimento local: mostra o botão "Entrar como dev". Ignorado em produção.
HUBCASH_DEV_LOGIN=false

PORT=8080
