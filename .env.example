# HubCash: copie para .env em desenvolvimento ou configure na Railway.
# Nunca coloque valores reais neste arquivo.

# Chave que cifra os tokens do Mercado Pago no banco (32+ caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se perder essa chave, as contas do Mercado Pago precisam ser cadastradas de novo.
HUBCASH_MASTER_KEY=

# Senha de acesso ao painel.
HUBCASH_ADMIN_PASSWORD=

# Endereço público do HubCash (usado nos webhooks), ex.: https://hubcash.up.railway.app
HUBCASH_PUBLIC_URL=

# Supabase (sem estas duas, os dados ficam só na memória e somem ao reiniciar).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=8080
